<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HalimRecovery</AssemblyName>
    <Version>0.5.0</Version>
    <Authors>Halim Toklu</Authors>
    <Product>Halim Recovery</Product>
    <Description>Free and open source Windows data recovery</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HalimRecovery.Core\HalimRecovery.Core.csproj" />
  </ItemGroup>

</Project>
