<Window x:Class="HalimRecovery.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:HalimRecovery.App.ViewModels"
        Title="Halim Recovery — Free &amp; Open Source Windows Data Recovery"
        Width="1180" Height="760" MinWidth="960" MinHeight="600"
        Icon="Assets/app.ico"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== HOME ==================== -->
        <Grid Grid.Row="0" Visibility="{Binding IsHomeVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="640">
                <TextBlock Text="HALIM RECOVERY" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Recover deleted files safely." Style="{StaticResource Dim}" FontSize="16"
                           HorizontalAlignment="Center" Margin="0,6,0,28"/>

                <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                        CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="1.  Select the drive your files were deleted from" Margin="0,0,0,8"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="⟳" Margin="8,0,0,0" Padding="10,6"
                                    Command="{Binding RefreshDrivesCommand}" ToolTip="Refresh drive list"/>
                            <ComboBox ItemsSource="{Binding Volumes}" SelectedItem="{Binding SelectedVolume}"
                                      FontSize="14">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#1A1A1A">
                                            <Run Text="{Binding DriveLetter, Mode=OneWay}"/><Run Text=": "/>
                                            <Run Text="{Binding Label, Mode=OneWay}"/>
                                            <Run Text=" ["/><Run Text="{Binding FileSystemName, Mode=OneWay}"/><Run Text="]"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>

                        <Border Background="#2A2415" BorderBrush="#665C33" BorderThickness="1" CornerRadius="6"
                                Padding="10" Margin="0,12,0,0"
                                Visibility="{Binding SsdWarningVisible, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap" Foreground="#E8D9A0" FontSize="12"
                                       Text="This volume is on an SSD. Because of TRIM, Windows may have already erased the data of deleted files — some files may be impossible to recover, by any tool. Scan as soon as possible and avoid writing to this drive."/>
                        </Border>

                        <TextBlock Text="2.  Choose a scan type" Margin="0,18,0,8"/>
                        <UniformGrid Columns="3">
                            <Button Style="{StaticResource BtnPrimary}" Margin="0,0,6,0" Padding="14,12"
                                    Command="{Binding QuickScanCommand}">
                                <StackPanel>
                                    <TextBlock Text="Quick Scan" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White"/>
                                    <TextBlock Text="Deleted file records (fast)" FontSize="11" Foreground="#D6E4FF" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="3,0" Padding="14,12" Command="{Binding DeepScanCommand}">
                                <StackPanel>
                                    <TextBlock Text="Deep Scan" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Signature search (thorough)" FontSize="11" Style="{StaticResource Dim}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Padding="14,12" Command="{Binding DiskImageInfoCommand}">
                                <StackPanel>
                                    <TextBlock Text="Disk Image" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Planned" FontSize="11" Style="{StaticResource Dim}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="4,16,4,0" TextAlignment="Center"
                           Text="Tip: stop using the affected drive immediately. Every new write can permanently overwrite deleted files. Always recover to a different drive."/>
            </StackPanel>
        </Grid>

        <!-- ==================== RESULTS ==================== -->
        <Grid Grid.Row="0" Margin="14" Visibility="{Binding IsResultsVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- header row -->
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                <Button DockPanel.Dock="Left" Content="← Back" Command="{Binding BackHomeCommand}" Margin="0,0,10,0"/>
                <TextBlock DockPanel.Dock="Left" Text="{Binding ScanTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource BtnPrimary}" Content="Recover Selected…"
                        Command="{Binding RecoverSelectedCommand}" HorizontalAlignment="Right"/>
                <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding CancelScanCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                <Button DockPanel.Dock="Right" Content="Pause / Resume" Command="{Binding PauseResumeCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                <Border/>
            </DockPanel>

            <!-- progress row -->
            <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,10"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding ScanPhase}" Style="{StaticResource Dim}"/>
                        <TextBlock HorizontalAlignment="Right" Style="{StaticResource Dim}">
                            <Run Text="Elapsed "/><Run Text="{Binding ElapsedText}"/>
                            <Run Text="  ·  Remaining "/><Run Text="{Binding RemainingText}"/>
                            <Run Text="  ·  "/><Run Text="{Binding SpeedText}"/>
                            <Run Text="  ·  "/><Run Text="{Binding FilesFoundText}"/>
                        </TextBlock>
                    </DockPanel>
                    <ProgressBar Value="{Binding ScanPercent}" Maximum="100" IsIndeterminate="{Binding ScanIndeterminate}"/>
                </StackPanel>
            </Border>

            <!-- filter row -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Width="150" ItemsSource="{Binding FilterOptions}"
                          SelectedItem="{Binding SelectedFilterOption}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Search by file name or path" Margin="0,0,8,0"/>
                <TextBox Grid.Column="2" Text="{Binding NaturalQuery, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Smart search, e.g. 'tatil fotoğrafları geçen ay' or 'invoice PDFs from 2025'">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ApplyNaturalQueryCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Content="Smart Filter" Command="{Binding ApplyNaturalQueryCommand}" Margin="8,0,0,0"/>
                    <Button Content="✕" Command="{Binding ClearNaturalQueryCommand}" Margin="4,0,0,0" Padding="8,6"/>
                </StackPanel>
            </Grid>

            <!-- results + preview -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <DataGrid Grid.Column="0" x:Name="ResultsGrid" ItemsSource="{Binding ResultsView}"
                          SelectedItem="{Binding SelectedFile}" SelectionChanged="ResultsGrid_SelectionChanged"
                          EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="220"/>
                        <DataGridTextColumn Header="Original Path" Binding="{Binding OriginalPath}" Width="*"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="80"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeText}" Width="60"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding DateText}" Width="120"/>
                        <DataGridTemplateColumn Header="Health" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding HealthTooltip}">
                                        <Ellipse Width="9" Height="9" Fill="{Binding HealthBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding HealthText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Conf." Binding="{Binding Confidence, StringFormat={}{0}%}" Width="55"/>
                        <DataGridTextColumn Header="Found by" Binding="{Binding SourceText}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Column="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                        BorderThickness="1" CornerRadius="8" Margin="10,0,0,0" Padding="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Preview" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Image Source="{Binding PreviewImage}" MaxHeight="260" Stretch="Uniform"
                                   HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" FontSize="12"
                                       FontFamily="Consolas" Style="{StaticResource Dim}"/>
                            <TextBlock Text="Health details" FontWeight="SemiBold" Margin="0,14,0,4"/>
                            <TextBlock Text="{Binding HealthNotesText}" TextWrapping="Wrap" FontSize="12"
                                       Style="{StaticResource Dim}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- ==================== FOOTER ==================== -->
        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"
                Padding="14,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Dim}">
                    <Run Text="Halim Recovery"/> <Run Text="{Binding VersionText, Mode=OneWay}"/> <Run Text=" · Free &amp; Open Source"/>
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Style="{StaticResource Dim}"
                           Text="Made with ❤️ by Halim Toklu"/>
                <Button HorizontalAlignment="Center" Content="❤️ Support Development" FontSize="12" Padding="10,4"
                        Command="{Binding OpenSupportCommand}"/>
            </DockPanel>
        </Border>

        <!-- status message overlay -->
        <TextBlock Grid.Row="0" Text="{Binding StatusMessage}" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                   Margin="16,0,0,8" FontSize="12" Foreground="{StaticResource Accent}"
                   Visibility="{Binding IsResultsVisible, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</Window>
